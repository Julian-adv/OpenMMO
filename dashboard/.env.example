DASHBOARD_API_TARGET=http://127.0.0.1:10007
DASHBOARD_BASE=/
# 기본값은 client/의 Google 로그인 설정입니다. 다른 ID가 필요할 때만 지정합니다.
# VITE_GOOGLE_CLIENT_ID=
# HTTPS 개발 서버: client/.certs 인증서를 지정하면 https://localhost:10008 로 서빙합니다.
# VITE_HTTPS_KEY=../client/.certs/key.pem
# VITE_HTTPS_CERT=../client/.certs/cert.pem
# VITE_HTTPS_CA=../client/.certs/ca.pem
